# ─── 1. Dependências (inclui devDependencies para compilar) ─────────────────
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund

# ─── 2. Build: cliente Prisma, API e seed compilados ────────────────────────
FROM deps AS builder
COPY tsconfig*.json nest-cli.json prisma.config.ts ./
COPY src ./src
RUN npx prisma generate \
  && npm run build \
  && npm run build:seed \
  # Só dependências de runtime seguem para a imagem final.
  && npm prune --omit=dev --no-audit --no-fund \
  && npm cache clean --force

# ─── 3. Runtime: imagem mínima, utilizador sem privilégios ──────────────────
FROM node:22-alpine AS runner
# openssl: usado pelo motor de migrações do Prisma. tini: init mínimo (PID 1)
# que reencaminha sinais e recolhe processos órfãos.
RUN apk add --no-cache openssl tini

ENV NODE_ENV=production \
    PORT=3000 \
    API_PREFIX=api/v1
WORKDIR /app

# Ficheiros só de leitura para a aplicação: pertencem ao root; o processo
# corre como `node` (uid 1000) e não consegue alterar o próprio código.
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY scripts/docker-entrypoint.sh ./docker-entrypoint.sh

USER node
EXPOSE 3000

# 200 só quando a API responde e a BD está acessível (ver HealthController).
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/${API_PREFIX}/health" || exit 1

ENTRYPOINT ["/sbin/tini", "--", "./docker-entrypoint.sh"]
