# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Security & Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5
JWT_ACCESS_SECRET=your_jwt_access_secret_should_be_long_and_secure
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_should_be_long_and_secure
JWT_REFRESH_EXPIRATION=7d

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bulir_reservas?schema=public"
