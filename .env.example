# Application
PORT=3000
NODE_ENV=development
# URL público da API (servidor da spec OpenAPI em /reference e /openapi.json).
# Opcional: sem ele usa RENDER_EXTERNAL_URL (no Render) ou http://localhost:PORT.
APP_URL=http://localhost:3000
API_PREFIX=api/v1
# Nível de log do pino (fatal|error|warn|info|debug|trace|silent). Omissão: info em produção, debug fora dela.
# LOG_LEVEL=info

# HTTP
# Origens web autorizadas por CORS, separadas por vírgulas (app web Vite :5173, Expo web :8081), ou "*".
# A app mobile nativa não envia Origin e não depende desta lista.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Tamanho máximo do corpo JSON (16kb, 1mb, ...). Acima → 413.
BODY_LIMIT=16kb
# Nº de proxies/load balancers à frente da API (0 = ligação direta; Render/Railway = 1).
TRUST_PROXY=0

# Security & Rate Limiting (THROTTLE_TTL em segundos; limites por janela de 1 min)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# POST /auth/login e /auth/register, por IP
AUTH_THROTTLE_LIMIT=5
# POST /bookings, PATCH /bookings/:id/cancel e POST /wallet/top-up, por utilizador
MONEY_THROTTLE_LIMIT=10
# Segredos JWT: valores longos e aleatórios, diferentes entre si. Gerar com:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_should_be_long_and_secure
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_should_be_long_and_secure
JWT_REFRESH_EXPIRATION=7d

# Database
# Em produção com Neon/Postgres gerido: ligação direta (não "pooled") e ?sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bulir_reservas?schema=public"
# Ligações máximas no pool desta instância e tempo máximo de uma query (ms)
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# Arranque do contentor de produção (scripts/docker-entrypoint.sh)
# Aplica `prisma migrate deploy` antes de iniciar a API.
RUN_MIGRATIONS=true
# Garante as contas de demonstração (seed em modo ensure: idempotente, nunca apaga dados).
SEED_DEMO_DATA=false
# Seed manual (`npm run db:seed`): reset apaga e recria tudo (bloqueado em produção);
# ensure só cria as contas de demonstração se não existirem. Omissão: reset fora de produção, ensure em produção.
# SEED_MODE=reset

# Docker Compose de produção local (docker-compose.yml)
# POSTGRES_PASSWORD=troque_esta_password
# API_PORT=3000
